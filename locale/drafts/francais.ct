; --- CLI: vault_err()'s own strings, wrapped by MSG_CLI_ERR below ---------
;
MSG_ERR_IO
impossible de lire/écrire le fichier du coffre-fort
;
MSG_ERR_FORMAT
fichier de coffre-fort invalide
;
MSG_ERR_AUTH
phrase de passe incorrecte ou fichier altéré
;
MSG_ERR_LOCKED
le coffre-fort est verrouillé
;
MSG_ERR_FULL
le coffre-fort est plein
;
MSG_ERR_RANGE
compte introuvable
;
MSG_ERR_UNKNOWN
erreur
